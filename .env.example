AI_AGENT_LOG_LEVEL=INFO
AI_AGENT_LLM_BASE_URL=http://127.0.0.1:8080/v1
AI_AGENT_LLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct-GGUF:Q4_K_M
AI_AGENT_LLM_TIMEOUT_SECONDS=60
AI_AGENT_LLM_CONNECT_TIMEOUT_SECONDS=5
AI_AGENT_LLM_MAX_TOKENS=512
AI_AGENT_LLM_TEMPERATURE=0
# Configure these only when connecting to an MCP endpoint.
# AI_AGENT_MCP_URL=https://mcp.example.com/mcp
# AI_AGENT_MCP_TOKEN=replace-with-service-token
AI_AGENT_MCP_CONNECT_TIMEOUT_SECONDS=10
AI_AGENT_MCP_CALL_TIMEOUT_SECONDS=30
AI_AGENT_MCP_MAX_RESULT_BYTES=262144

# Configure only for PostgreSQL checkpoints. Provision the schema separately.
# AI_AGENT_CHECKPOINT_DSN=postgresql://user:password@host/database
# AI_AGENT_CHECKPOINT_SCHEMA=ai_checkpoints

# Служебные вызовы между AI Backend, auth и incidents.
# AI_AGENT_AUTH_URL=http://auth.apps:8001
# AI_AGENT_AUTH_CLIENT_SECRET=replace-with-service-secret
# AI_AGENT_INCIDENTS_URL=http://incidents.apps:8006
